---
import ChevronDown from "@lucide/astro/icons/chevron-down";
import { twMerge } from "tailwind-merge";

type Props = {
    class?: string;
};

const { class: className } = Astro.props;
---

<div class={twMerge("scrollable-container flex flex-col items-center gap-4", className)}>
    <div class="scrollable-content w-full overflow-x-hidden overflow-y-auto">
        <slot />
    </div>
    <button
        type="button"
        class="scroll-btn hidden cursor-pointer transition-transform [.reached-end]:rotate-180 [.scrollable]:block">
        <ChevronDown class="size-8 animate-pulse" />
    </button>
</div>

<script>
    for (const container of document.querySelectorAll<HTMLDivElement>(".scrollable-container")) {
        const content = container.querySelector<HTMLDivElement>(".scrollable-content")!;
        const button = container.querySelector<HTMLButtonElement>(".scroll-btn")!;

        const observer = new ResizeObserver(() => {
            button.classList.toggle("scrollable", content.scrollHeight > content.offsetHeight);
        });

        observer.observe(container);

        let reachedEnd = false;

        button.addEventListener("click", () => {
            content.scroll({
                top: reachedEnd ? 0 : content.scrollHeight,
                behavior: "smooth",
            });
        });

        content.addEventListener("scroll", () => {
            reachedEnd = content.clientHeight + content.scrollTop >= content.scrollHeight;
            button.classList.toggle("reached-end", reachedEnd);
        });
    }
</script>
