---
import { Image } from "astro:assets";

type Props = {
    name: string;
    year: number;
    type: "personal" | "school";
    image: ImageMetadata;
};

const { name, year, type, image } = Astro.props;
---

<li
    class="project-card group relative flex aspect-video h-40 translate-x-12 cursor-pointer flex-col items-start justify-between overflow-hidden rounded-sm text-left opacity-0 shadow-lg shadow-black/10 transition-all duration-1000 [.visible]:translate-x-0 [.visible]:opacity-100">
    <Image
        class="absolute h-full w-full object-cover object-center opacity-40 transition-opacity group-hover:opacity-75"
        src={image}
        alt={name}
    />
    <div class="z-10 p-2">
        <h3 class="text-xl font-bold text-shadow-black/50 text-shadow-xs">
            {name}
        </h3>
        <time class="font-light text-shadow-black/50 text-shadow-sm" datetime={year.toString()}>
            {year}
        </time>
    </div>
    <p class="z-10 w-full bg-black/20 p-1 text-center font-bold capitalize">
        {type}
    </p>
    <div
        class="invisible fixed top-1/2 left-1/2 -translate-1/2 scale-0 bg-black transition-all group-[.open]:visible group-[.open]:scale-100">
        <p>Hello World</p>
    </div>
</li>

<script>
    const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
            entry.target.classList.toggle("visible", entry.isIntersecting);
        }
    });

    const projectCards = document.querySelectorAll<HTMLLIElement>(".project-card");
    for (let i = 0; i < projectCards.length; i++) {
        const card = projectCards[i];

        card.style.transitionDelay = `${i * 100}ms`;

        card.addEventListener("click", () => {
            card.classList.toggle("open");
        });

        observer.observe(card);
    }
</script>
