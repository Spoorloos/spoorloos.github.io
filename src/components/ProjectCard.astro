---
import { Image } from "astro:assets";
import { twMerge } from "tailwind-merge";
import Github from "simple-icons-astro/Github";
import ExternalLink from "@lucide/astro/icons/external-link";

type Props = {
    name: string;
    year: number;
    schoolYear: string;
    type: "personal" | "school";
    groupProject?: boolean;
    image: ImageMetadata;
    githubLink: string;
    liveLink?: string;
    class?: string;
};

const {
    name,
    year,
    schoolYear,
    type,
    image,
    githubLink,
    liveLink,
    groupProject = false,
    class: className,
} = Astro.props;
---

<li
    class={twMerge(
        "project-card group relative flex aspect-video h-40 translate-x-12 flex-col justify-between overflow-hidden rounded-sm text-left opacity-0 shadow-lg shadow-black/10 transition-all ease-in-out duration-1000 [.visible]:translate-x-0 [.visible]:opacity-100",
        className
    )}>
    <Image
        class="has-pointer:opacity-40 has-pointer:group-hover:opacity-75 has-pointer:transition-opacity absolute h-full w-full object-cover object-center"
        src={image}
        alt={name}
    />
    <div class="z-10 flex w-full items-start justify-between gap-5 p-2">
        <div>
            <h3 class="text-xl font-bold text-shadow-black/50 text-shadow-xs">
                {name}
            </h3>
            <time class="font-light text-shadow-black/50 text-shadow-sm" datetime={year.toString()}>
                {year} | {schoolYear}
            </time>
        </div>
        <div
            class="has-pointer:opacity-0 has-pointer:group-hover:opacity-100 has-pointer:transition-opacity flex gap-2">
            <a
                class="has-pointer:text-white/50 has-pointer:transition-colors has-pointer:hover:text-white"
                href={githubLink}
                target="_blank">
                <Github class="size-6" />
            </a>
            {
                liveLink !== undefined && (
                    <a
                        class="has-pointer:text-white/50 has-pointer:transition-colors has-pointer:hover:text-white"
                        href={liveLink}
                        target="_blank">
                        <ExternalLink class="size-6" />
                    </a>
                )
            }
        </div>
    </div>

    <p class="z-10 w-full p-1 text-center opacity-0 transition-opacity group-hover:opacity-100">
        <span class="font-bold capitalize">{type}</span>
        {groupProject && <span class="font-light">- group project</span>}
    </p>
</li>

<script>
    const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
            entry.target.classList.toggle("visible", entry.isIntersecting);
        }
    });

    for (const card of document.querySelectorAll<HTMLLIElement>(".project-card")) {
        observer.observe(card);
    }
</script>
