---
import { Image } from "astro:assets";
import { twMerge } from "tailwind-merge";

type Props = {
    name: string;
    year: number;
    schoolYear: string;
    type: "personal" | "school";
    image: ImageMetadata;
    href: string;
    class?: string;
};

const { name, year, schoolYear, type, image, href, class: className } = Astro.props;
---

<a {href} target="_blank">
    <li
        class={twMerge(
            "project-card group relative flex aspect-video h-40 translate-x-12 cursor-pointer flex-col items-start justify-between overflow-hidden rounded-sm text-left opacity-0 shadow-lg shadow-black/10 transition-all duration-1000 [.visible]:translate-x-0 [.visible]:opacity-100",
            className
        )}>
        <Image
            class="absolute h-full w-full object-cover object-center opacity-40 transition-opacity group-hover:opacity-75"
            src={image}
            alt={name}
        />
        <div class="z-10 p-2">
            <h3 class="text-xl font-bold text-shadow-black/50 text-shadow-xs">
                {name}
            </h3>
            <time class="font-light text-shadow-black/50 text-shadow-sm" datetime={year.toString()}>
                {year} | {schoolYear}
            </time>
        </div>
        <p class="z-10 w-full bg-black/20 p-1 text-center font-bold capitalize">
            {type}
        </p>
    </li>
</a>

<script>
    const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
            entry.target.classList.toggle("visible", entry.isIntersecting);
        }
    });

    for (const card of document.querySelectorAll<HTMLLIElement>(".project-card")) {
        observer.observe(card);
    }
</script>
