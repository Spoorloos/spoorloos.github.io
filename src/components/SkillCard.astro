---
type Props = {
    title: string;
    percent: number;
    hidden?: boolean;
};

const { title, percent, hidden = false } = Astro.props;
---

<li
    class={`skill-card w-full max-w-xl group flex flex-col gap-1 ${hidden ? "opacity-20 cursor-not-allowed" : ""}`}>
    <h3
        class={`text-xl font-light text-white/70 transition-colors text-shadow-black text-shadow-md ${hidden ? "" : "group-hover:text-white"}`}>
        {title}
    </h3>
    <div class="h-2 w-full rounded-sm bg-linear-to-b from-white/10 to-white/15">
        <div
            class="h-full origin-left scale-x-0 transition-transform duration-1000 ease-in-out will-change-[scale] group-[.visible]:scale-x-100 group-[:not(.visible)]:transition-none rtl:origin-right"
            style={{ width: `${percent}%` }}>
            <div
                class="size-full rounded-sm bg-[#5257e5] inset-shadow-xs inset-shadow-black/20 transition-colors group-hover:bg-[#6fe3e1]">
            </div>
        </div>
    </div>
</li>

<script>
    const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
            entry.target.classList.toggle("visible", entry.isIntersecting);
        }
    });

    for (const card of document.querySelectorAll<HTMLLIElement>(".skill-card")) {
        observer.observe(card);
    }
</script>
