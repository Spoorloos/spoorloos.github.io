---
import { twMerge } from "tailwind-merge";

type Props = astroHTML.JSX.HTMLAttributes;

const { class: className, ...rest } = Astro.props;
---

<div class="h-screen">
    <section
        class={twMerge(
            "flex h-dvh snap-center snap-always flex-col items-center justify-center gap-4 py-4 px-8 text-center",
            className
        )}
        {...rest}>
        <slot />
    </section>
</div>
