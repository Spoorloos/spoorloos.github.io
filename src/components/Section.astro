---
import { twMerge } from "tailwind-merge";

type Props = {
    id?: string;
    class?: string;
};

const { id, class: className } = Astro.props;
---

<section
    class={twMerge(
        "flex h-screen flex-col items-center justify-center gap-4 py-4 px-8 text-center snap-center snap-always",
        className
    )}
    {id}>
    <slot />
</section>
