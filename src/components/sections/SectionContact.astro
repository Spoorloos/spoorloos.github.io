---
import Github from "simple-icons-astro/Github";
import Telegram from "simple-icons-astro/Telegram";
---

<section class="main-section" id="contact">
    <h2 class="text-4xl leading-none font-extrabold tracking-tight text-white md:text-5xl lg:text-6xl">
        Get in contact
    </h2>
    <p class="text-xl font-extralight text-zinc-300 italic">Get in contact with me.</p>
    <form
        class="group flex scale-0 flex-col gap-3 opacity-0 transition-transform duration-1000 ease-in-out [.visible]:scale-100 [.visible]:opacity-100"
        autocomplete="off"
        id="contact-form">
        <div class="flex flex-wrap gap-3">
            <input
                class="contact-input form-sending flex-1"
                type="text"
                name="first_name"
                minlength={1}
                maxlength={50}
                placeholder="First name"
                required
            />
            <input
                class="contact-input form-sending flex-1"
                type="text"
                name="last_name"
                minlength={2}
                maxlength={100}
                placeholder="Last name"
                required
            />
        </div>
        <input
            class="contact-input form-sending"
            type="email"
            name="email"
            placeholder="email@example.com"
            required
        />
        <!-- prettier-ignore -->
        <Fragment>
            <textarea
                class="contact-input form-sending"
                name="message"
                placeholder="Enter your message"
                minlength={1}
                maxlength={500}
                required/>
        </Fragment>
        <div class="flex items-stretch justify-between gap-2">
            <nav class="flex items-stretch gap-2">
                <a
                    class="button-secondary rounded-lg py-2"
                    href="https://github.com/Spoorloos/"
                    target="_blank">
                    <Github />
                </a>
                <a class="button-secondary rounded-lg py-2" href="https://t.me/notspoorloos" target="_blank">
                    <Telegram />
                </a>
            </nav>
            <button class="button-primary form-sending rounded-lg px-3 py-2" type="submit">Send</button>
        </div>
        <!-- Success message -->
        <p class="hidden text-green-400 group-[[success=true]]:block">
            <span class="font-medium">Success!</span> your message was sent successfully.
        </p>
        <!-- Fail message -->
        <p class="hidden text-red-400 group-[[success=false]]:block">
            <span class="font-medium">Oh no!</span> we couldn't send your message.
        </p>
    </form>
</section>

<script>
    const form = document.querySelector<HTMLFormElement>("#contact-form")!;

    const observer = new IntersectionObserver((entries) => {
        form.classList.toggle("visible", entries[0].isIntersecting);
    });

    observer.observe(form);

    form.addEventListener("submit", async (event) => {
        event.preventDefault();

        form.classList.toggle("sending", true);

        try {
            const response = await fetch("https://formspree.io/f/xgvnklrj", {
                method: "post",
                body: new FormData(form),
                headers: {
                    Accept: "application/json",
                },
            });

            const parsed = await response.json();

            form.setAttribute("success", (parsed?.ok === true).toString());
        } catch {
            form.setAttribute("success", "false");
        } finally {
            form.classList.toggle("sending", false);
        }
    });
</script>
