---
import Github from "simple-icons-astro/Github";
import Telegram from "simple-icons-astro/Telegram";
import Copy from "@lucide/astro/icons/copy";
import Check from "@lucide/astro/icons/check";
import Mail from "@lucide/astro/icons/mail";
---

<section class="main-section" id="contact">
    <h2 class="text-4xl leading-none font-extrabold tracking-tight text-white md:text-5xl lg:text-6xl">
        Get in contact
    </h2>
    <p class="text-xl font-extralight text-zinc-300 italic">Get in contact with me.</p>
    <form
        class="group flex scale-0 flex-col gap-3 opacity-0 transition-transform duration-1000 ease-out [.visible]:scale-100 [.visible]:opacity-100"
        autocomplete="off"
        id="contact-form">
        <div class="flex flex-wrap gap-3">
            <input
                class="contact-input form-sending flex-1"
                type="text"
                name="first_name"
                minlength={1}
                maxlength={50}
                placeholder="First name"
                required
            />
            <input
                class="contact-input form-sending flex-1"
                type="text"
                name="last_name"
                minlength={2}
                maxlength={100}
                placeholder="Last name"
                required
            />
        </div>
        <input
            class="contact-input form-sending"
            type="email"
            name="email"
            placeholder="email@example.com"
            required
        />
        <!-- prettier-ignore -->
        <Fragment>
            <textarea
                class="contact-input form-sending"
                name="message"
                placeholder="Enter your message"
                minlength={1}
                maxlength={500}
                required/>
        </Fragment>
        <div class="flex flex-wrap justify-end gap-2">
            <a class="button-secondary rounded-lg py-2" href="https://github.com/Spoorloos/" target="_blank">
                <Github />
            </a>
            <a class="button-secondary rounded-lg py-2" href="https://t.me/notspoorloos" target="_blank">
                <Telegram />
            </a>
            <!-- <div class="not-sm:-order-1 not-sm:w-full sm:flex-1">
                <button
                    class="group/emailbtn button-secondary flex w-32 justify-between gap-2 rounded-lg p-2 text-left font-normal transition-all not-sm:w-full hover:w-full"
                    type="button"
                    id="copy-email-btn">
                    <span class="truncate">mick.negenman@icloud.com</span>
                    <div class="group-hover/emailbtn:contents pointer-fine:hidden">
                        <Copy class="block group-[[copied]]/emailbtn:hidden" />
                        <Check class="hidden group-[[copied]]/emailbtn:block" />
                    </div>
                </button>
            </div> -->
            <button
                class="button-secondary group/emailbtn flex rounded-lg py-2 not-sm:order-1 not-sm:w-full"
                id="copy-email-btn"
                type="button">
                <div
                    class="grid grid-cols-[1fr] opacity-100 transition-all duration-500 not-sm:hidden not-pointer-fine:hidden group-hover/emailbtn:grid-cols-[0fr] group-hover/emailbtn:opacity-0">
                    <div class="overflow-hidden">
                        <Mail />
                    </div>
                </div>
                <div
                    class="grid transition-all duration-500 not-sm:w-full group-hover/emailbtn:grid-cols-[1fr] group-hover/emailbtn:opacity-100 pointer-fine:sm:grid-cols-[0fr] pointer-fine:sm:opacity-0">
                    <div class="flex items-center justify-between gap-2 overflow-hidden">
                        <span>mick.negenman@icloud.com</span>
                        <Copy class="block size-6 group-[[copied]]/emailbtn:hidden" />
                        <Check class="hidden size-6 group-[[copied]]/emailbtn:block" />
                    </div>
                </div>
            </button>
            <button class="button-primary form-sending ml-auto rounded-lg px-3 py-2" type="submit">
                Send
            </button>
        </div>
        <p class="hidden text-green-400 group-[[success=true]]:block">
            <span class="font-medium">Success!</span> your message was sent successfully.
        </p>
        <p class="hidden text-red-400 group-[[success=false]]:block">
            <span class="font-medium">Oh no!</span> we couldn't send your message.
        </p>
    </form>
</section>

<script>
    const form = document.querySelector<HTMLFormElement>("#contact-form")!;

    const observer = new IntersectionObserver((entries) => {
        form.classList.toggle("visible", entries[0].isIntersecting);
    });

    observer.observe(form);

    form.addEventListener("submit", async (event) => {
        event.preventDefault();

        form.classList.toggle("sending", true);

        try {
            const response = await fetch("https://formspree.io/f/xgvnklrj", {
                method: "post",
                body: new FormData(form),
                headers: {
                    Accept: "application/json",
                },
            });

            const parsed = await response.json();

            form.setAttribute("success", (parsed?.ok === true).toString());
        } catch {
            form.setAttribute("success", "false");
        } finally {
            form.classList.toggle("sending", false);
        }
    });

    const copyButton = document.querySelector<HTMLButtonElement>("#copy-email-btn")!;

    copyButton.addEventListener("click", () => {
        copyButton.toggleAttribute("copied", true);
        navigator.clipboard.writeText("mick.negenman@icloud.com");
        setTimeout(() => copyButton.toggleAttribute("copied", false), 2000);
    });
</script>
