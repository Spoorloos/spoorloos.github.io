---
import Github from "simple-icons-astro/Github";
import Telegram from "simple-icons-astro/Telegram";
import Copy from "@lucide/astro/icons/copy";
import Check from "@lucide/astro/icons/check";
import Mail from "@lucide/astro/icons/mail";

const lang = await import(`@/locales/${Astro.currentLocale}.json`);
---

<section class="main-section" id="contact">
    <h2 class="text-4xl leading-none font-extrabold tracking-tight text-white md:text-5xl lg:text-6xl">
        {lang.contact.title}
    </h2>
    <p class="text-xl font-extralight text-zinc-300 italic">{lang.contact.sub}</p>
    <form
        class="group flex scale-0 flex-col gap-3 opacity-0 transition-transform duration-1000 ease-out [.visible]:scale-100 [.visible]:opacity-100"
        autocomplete="off"
        id="contact-form">
        <div class="flex flex-wrap gap-3">
            <input
                class="contact-input form-sending flex-1"
                type="text"
                name="first_name"
                minlength={1}
                maxlength={50}
                placeholder={lang.contact.placeholders.first_name}
                required
            />
            <input
                class="contact-input form-sending flex-1"
                type="text"
                name="last_name"
                minlength={2}
                maxlength={100}
                placeholder={lang.contact.placeholders.last_name}
                required
            />
        </div>
        <input
            class="contact-input form-sending"
            type="email"
            name="email"
            placeholder={lang.contact.placeholders.email}
            required
        />
        <!-- prettier-ignore -->
        <Fragment>
            <textarea
                class="contact-input form-sending"
                name="message"
                placeholder={lang.contact.placeholders.message}
                minlength={1}
                maxlength={500}
                required/>
        </Fragment>
        <div class="flex flex-wrap justify-end gap-2">
            <a class="button-secondary rounded-lg py-2" href="https://github.com/Spoorloos/" target="_blank">
                <Github class="size-6" />
            </a>
            <a class="button-secondary rounded-lg py-2" href="https://t.me/notspoorloos" target="_blank">
                <Telegram class="size-6" />
            </a>
            <button
                class="button-secondary group/emailbtn flex rounded-lg py-2 not-sm:order-1 not-sm:w-full"
                id="copy-email-btn"
                type="button">
                <Mail
                    class="size-6 opacity-100 transition-all duration-500 not-sm:hidden not-pointer-fine:hidden group-hover/emailbtn:w-0 group-hover/emailbtn:opacity-0"
                />
                <span
                    class="grid transition-all duration-500 not-sm:w-full group-hover/emailbtn:grid-cols-[1fr] group-hover/emailbtn:opacity-100 pointer-fine:sm:grid-cols-[0fr] pointer-fine:sm:opacity-0">
                    <span class="flex items-center justify-between gap-2 overflow-hidden">
                        mick.negenman@icloud.com
                        <Copy class="block size-6 group-[.copied]/emailbtn:hidden" />
                        <Check class="hidden size-6 group-[.copied]/emailbtn:block" />
                    </span>
                </span>
            </button>
            <button class="button-primary form-sending ms-auto rounded-lg px-3 py-2" type="submit">
                {lang.contact.send}
            </button>
        </div>
        <p class="hidden text-green-400 group-[[success=true]]:block">
            {lang.contact.errors.success}
        </p>
        <p class="hidden text-red-400 group-[[success=false]]:block">
            {lang.contact.errors.fail}
        </p>
    </form>
</section>

<script>
    const form = document.querySelector<HTMLFormElement>("#contact-form")!;

    const observer = new IntersectionObserver((entries) => {
        form.classList.toggle("visible", entries[0].isIntersecting);
    });

    observer.observe(form);

    form.addEventListener("submit", async (event) => {
        event.preventDefault();

        form.classList.toggle("sending", true);

        try {
            const response = await fetch("https://formspree.io/f/xgvnklrj", {
                method: "post",
                body: new FormData(form),
                headers: {
                    Accept: "application/json",
                },
            });

            const parsed = await response.json();

            form.setAttribute("success", (parsed?.ok === true).toString());
        } catch {
            form.setAttribute("success", "false");
        } finally {
            form.classList.toggle("sending", false);
        }
    });

    const copyButton = document.querySelector<HTMLButtonElement>("#copy-email-btn")!;

    copyButton.addEventListener("click", () => {
        copyButton.classList.toggle("copied", true);
        navigator.clipboard.writeText("mick.negenman@icloud.com");
        setTimeout(() => copyButton.classList.toggle("copied", false), 2000);
    });
</script>
