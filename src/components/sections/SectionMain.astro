---
const lang = await import(`@/locales/${Astro.currentLocale}.json`);
---

<section class="main-section animate-fade">
    <h2 class="text-2xl text-white/50 italic drop-shadow-xl drop-shadow-white/10">
        {lang.main.sub}
    </h2>
    <p class="text-6xl font-bold drop-shadow-xl drop-shadow-white/10">
        {lang.main.i_am}
        <span
            class={String.raw`after:animate-fade-in-out bg-linear-to-b from-[#6fe3e1] to-[#5257e5] bg-clip-text text-transparent after:content-['\_']`}
            id="description-text"
            data-descriptions={JSON.stringify(lang.main.descriptions)}>
        </span>
    </p>
    <div class="space-x-2">
        <a class="button-primary inline-block" href="#contact">{lang.main.contact}</a>
        <a class="button-secondary inline-block" href="#projects">{lang.main.projects}</a>
    </div>
</section>

<script>
    const descText = document.querySelector<HTMLSpanElement>("#description-text")!;
    const descriptions = JSON.parse(descText.dataset.descriptions!);

    let descriptionIndex = 0;
    let letterIndex = 0;
    let removeWord = false;

    function showNextLetter() {
        const currentDescription = descriptions[descriptionIndex];

        descText.innerText = currentDescription.slice(0, letterIndex);

        letterIndex = removeWord ? letterIndex - 1 : letterIndex + 1;

        if (removeWord && letterIndex === 0) {
            removeWord = false;
            descriptionIndex = (descriptionIndex + 1) % descriptions.length;
        }

        if (letterIndex > currentDescription.length) {
            removeWord = true;
            setTimeout(showNextLetter, 1000);
        } else {
            setTimeout(showNextLetter, removeWord ? 50 : Math.random() * 100);
        }
    }

    showNextLetter();
</script>
