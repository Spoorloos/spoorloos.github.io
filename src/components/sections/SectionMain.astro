---
import Section from "@/components/Section.astro";
import { locales } from "@/scripts/localization";

const lang = locales[Astro.currentLocale!];
---

<Section class="animate-fade">
    <h2 class="text-2xl text-white/50 italic drop-shadow-xl drop-shadow-white/10">
        {lang.main.sub}
    </h2>
    <p class="text-6xl font-bold drop-shadow-xl drop-shadow-white/10">
        {lang.main.i_am}
        <span
            class={String.raw`after:animate-fade-in-out bg-linear-to-b from-[#6fe3e1] to-[#5257e5] bg-clip-text text-transparent after:content-['\_']`}
            id="description-text"
            data-descriptions={JSON.stringify(lang.main.descriptions)}>
        </span>
    </p>
    <div class="space-x-2">
        <a class="button-primary inline-block" href="#contact">{lang.main.contact}</a>
        <a class="button-secondary inline-block" href="#projects">{lang.main.projects}</a>
    </div>
</Section>

<script>
    const descText = document.querySelector<HTMLSpanElement>("#description-text")!;
    const descriptions: string[] = JSON.parse(descText.dataset.descriptions!);

    let descIndex = 0;
    let letterIndex = 0;
    let deleteText = false;

    function showNextLetter() {
        const currentDesc = descriptions[descIndex];

        descText.innerText = currentDesc.slice(0, letterIndex);

        letterIndex += deleteText ? -1 : 1;

        let finishedWord = false;

        if (letterIndex > currentDesc.length) {
            deleteText = true;
            finishedWord = true;
        } else if (letterIndex === 0) {
            deleteText = false;
            descIndex = (descIndex + 1) % descriptions.length;
        }

        setTimeout(
            () => requestAnimationFrame(showNextLetter),
            finishedWord ? 2000 : deleteText ? 50 : Math.random() * 100
        );
    }

    requestAnimationFrame(showNextLetter);
</script>
