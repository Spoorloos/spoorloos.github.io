---
import Section from "@/components/Section.astro";
import SkillCard from "@/components/SkillCard.astro";
import ScrollableContainer from "@/components/ScrollableContainer.astro";
import { locales } from "@/scripts/locales";

const lang = locales[Astro.currentLocale!];
---

<Section id="skills">
    <h2 class="text-4xl leading-none font-extrabold tracking-tight text-white md:text-5xl">
        {lang.skills.title}
    </h2>
    <p class="text-xl font-extralight text-zinc-300 italic">
        {lang.skills.sub}
    </p>
    <ScrollableContainer class="max-h-96 w-full max-w-3xl">
        <div class="flex items-stretch gap-x-8 gap-y-3 text-start not-sm:flex-col">
            <ul class="flex-1 space-y-3">
                <SkillCard title="Javascript" percent={100} />
                <SkillCard title="Typescript" percent={90} />
                <SkillCard title="HTML" percent={95} />
                <SkillCard title="CSS" percent={95} />
                <SkillCard title="Tailwind" percent={90} />
                <SkillCard title="React" percent={90} />
            </ul>
            <ul class="flex-1 space-y-3">
                <SkillCard title="NextJS" percent={85} />
                <SkillCard title="C++" percent={65} />
                <SkillCard title="Rust" percent={40} />
                <SkillCard title="Lua" percent={100} />
                <SkillCard title="PHP" percent={0} hidden />
                <SkillCard title="Laravel" percent={0} hidden />
            </ul>
        </div>
    </ScrollableContainer>
</Section>
