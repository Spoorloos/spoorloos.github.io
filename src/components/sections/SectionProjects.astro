---
import ProjectCard from "../ProjectCard.astro";
import RobloxHouse from "../../assets/roblox_house.webp";
import WSChat from "../../assets/ws_chat.png";
import SVUnity from "../../assets/sv_unity.png";
import MuseumOnline from "../../assets/museum_online.png";
import DrukkerijAGS from "../../assets/drukkerij_ags.png";
import Portfolio from "../../assets/portfolio.png";
import ScrollableContainer from "../ScrollableContainer.astro";
---

<section class="main-section" id="projects">
    <h2 class="text-4xl leading-none font-extrabold tracking-tight text-white md:text-5xl">
        My Projects
    </h2>
    <p class="text-xl font-extralight text-zinc-300 italic">My personal and school projects.</p>
    <ScrollableContainer wrapperClass="max-w-6xl" class="flex flex-wrap justify-center gap-4">
        <ProjectCard
            name="Roblox Executor"
            year={2023}
            schoolYear="1st year"
            type="personal"
            image={RobloxHouse}
            href="https://github.com/Spoorloos/uwp_executor"
        />
        <ProjectCard
            name="Museum Online"
            schoolYear="1st year"
            year={2023}
            type="school"
            image={MuseumOnline}
            href="https://github.com/Spoorloos/bo_museum_online"
            class="delay-100"
        />
        <ProjectCard
            name="Websocket Chatroom"
            year={2024}
            schoolYear="2nd year"
            type="personal"
            image={WSChat}
            href="https://github.com/Spoorloos/ws_chat/"
            class="delay-200"
        />
        <ProjectCard
            name="S.V. Unity"
            schoolYear="2nd year"
            year={2025}
            type="school"
            image={SVUnity}
            href="https://github.com/Spoorloos/bo_sv_unity"
            class="delay-300"
        />
        <ProjectCard
            name="Drukkerij AGS"
            schoolYear="2nd year"
            year={2025}
            type="school"
            image={DrukkerijAGS}
            href="https://github.com/Spoorloos/skill_drukkerij_ags"
            class="delay-400"
        />
        <ProjectCard
            name="Portfolio"
            schoolYear="3rd year"
            year={2025}
            type="school"
            image={Portfolio}
            href="https://github.com/Spoorloos/spoorloos.github.io"
            class="delay-500"
        />
    </ScrollableContainer>
</section>
