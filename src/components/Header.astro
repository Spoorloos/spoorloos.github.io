---
import Binary from "@lucide/astro/icons/binary";
import { getRelativeLocaleUrl } from "astro:i18n";
import Languages from "@lucide/astro/icons/languages";

// @ts-expect-error
const locales = __ASTRO_INTERNAL_I18N_CONFIG__.i18n.locales as string[];
const lang = await import(`@/locales/${Astro.currentLocale}.json`);

const localeNames = await Promise.all(
    locales.map(async (locale) => {
        return [locale, (await import(`@/locales/${locale}.json`)).name];
    })
);
---

<header
    class="not-sm:nav-open:bg-black not-nav-open:delay-500 fixed top-0 z-20 flex w-full items-center justify-between p-4 transition-colors duration-300">
    <a class="animate-fade-down flex items-center gap-2" href={getRelativeLocaleUrl(Astro.currentLocale!)}>
        <Binary class="size-8" />
        <h1 class="text-3xl font-bold sm:text-2xl">{lang.header.title}</h1>
    </a>

    <button class="animate-fade-down relative h-6 w-7 cursor-pointer sm:hidden" id="nav-btn">
        <span
            class="nav-open:top-1/2 nav-open:-translate-y-1/2 nav-open:rotate-45 pointer-events-none absolute top-0 right-0 left-0 h-[0.1875rem] rounded-full bg-white transition-all">
        </span>
        <span
            class="nav-open:opacity-0 pointer-events-none absolute top-1/2 right-0 left-0 h-[0.1875rem] -translate-y-1/2 rounded-full bg-white transition-opacity">
        </span>
        <span
            class="nav-open:top-1/2 nav-open:-translate-y-1/2 nav-open:-rotate-45 pointer-events-none absolute top-full right-0 left-0 h-[0.1875rem] -translate-y-full rounded-full bg-white transition-all">
        </span>
    </button>

    <nav
        class="not-sm:nav-open:visible top-full right-0 left-0 flex not-sm:invisible not-sm:absolute not-sm:flex-col sm:items-center sm:gap-2">
        <a class="nav-link not-sm:nav-open:delay-0 sm:animate-delay-none not-sm:delay-500" href="#">
            {lang.header.nav.home}
        </a>
        <a class="nav-link not-sm:nav-open:delay-100 sm:animate-delay-100 not-sm:delay-400" href="#about-me">
            {lang.header.nav.about}
        </a>
        <a class="nav-link not-sm:nav-open:delay-200 sm:animate-delay-200 not-sm:delay-300" href="#skills">
            {lang.header.nav.skills}
        </a>
        <a class="nav-link not-sm:nav-open:delay-300 sm:animate-delay-300 not-sm:delay-200" href="#projects">
            {lang.header.nav.projects}
        </a>
        <a class="nav-link not-sm:nav-open:delay-400 sm:animate-delay-400 not-sm:delay-100" href="#contact">
            {lang.header.nav.contact}
        </a>
        <div class="group relative" id="langs-wrapper">
            <button
                class="nav-link not-sm:nav-open:delay-500 sm:animate-delay-500 flex w-full cursor-pointer items-center gap-2 not-sm:delay-0"
                id="langs-btn">
                <span class="sm:hidden">{lang.header.nav.language}</span>
                <Languages class="not-sm:hidden" />
            </button>
            <ul
                class="invisible absolute top-full mt-1 origin-top scale-y-0 space-y-0.5 rounded-lg border border-white/15 bg-white/10 p-2 text-white/80 opacity-0 drop-shadow-lg drop-shadow-white/10 transition-all ease-in not-sm:start-0 not-sm:text-start group-[.langs-open]:visible group-[.langs-open]:scale-y-100 group-[.langs-open]:opacity-100 sm:end-0 sm:text-end">
                {
                    localeNames.map(([locale, name]) => (
                        <li
                            class={`${locale === Astro.currentLocale ? "pointer-events-none font-bold text-white" : "text-white/50 transition-colors hover:text-white"} text-lg text-shadow-black/20 text-shadow-sm not-sm:text-xl`}>
                            <a class="block" href={getRelativeLocaleUrl(locale)}>
                                {name}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </div>
    </nav>
</header>

<div
    class="not-nav-open:opacity-0 not-nav-open:invisible not-nav-open:pointer-events-none fixed inset-0 z-10 backdrop-blur-xl transition-all duration-700 sm:hidden">
</div>

<script>
    const navBtn = document.querySelector<HTMLButtonElement>("#nav-btn")!;
    const langsBtn = document.querySelector<HTMLButtonElement>("#langs-btn")!;
    const langsWrapper = document.querySelector<HTMLDivElement>("#langs-wrapper")!;

    navBtn.addEventListener("click", () => {
        document.documentElement.classList.toggle("nav-open");
        langsWrapper.classList.toggle("langs-open", false);
    });

    langsBtn.addEventListener("click", () => {
        langsWrapper.classList.toggle("langs-open");
    });
</script>
