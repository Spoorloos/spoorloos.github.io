---
import "@/styles/global.css";
import "@fontsource-variable/inter";
import "@fontsource-variable/noto-naskh-arabic";
import Header from "@/components/Header.astro";
import { locales } from "@/scripts/locales";

const lang = locales[Astro.currentLocale!];
---

<html class="snap-y snap-mandatory scroll-smooth" lang={Astro.currentLocale} dir="auto">
    <!-- I love my girlfriend -->
    <head>
        <title>{lang.head.title}</title>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={lang.head.description} />
        <meta name="author" content={lang.head.author} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="sitemap" href="/sitemap-index.xml" />
    </head>
    <body
        class={`${Astro.currentLocale === "fa" ? "font-noto-naskh" : "font-inter"} nav-open:overflow-hidden bg-black text-white`}>
        <Header />
        <slot />
    </body>
</html>

<script>
    document.addEventListener("mousemove", ({ clientX, clientY }) => {
        const x = (clientX * 2) / window.innerWidth - 1;
        const y = (clientY * 2) / window.innerHeight - 1;

        document.body.style.setProperty("--offset-x", `${x * 12}px`);
        document.body.style.setProperty("--offset-y", `${y * 12}px`);
    });
</script>
